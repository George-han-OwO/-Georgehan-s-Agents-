# Murmur local HTTPS reverse proxy for the 4070 Windows host.
# This is deliberately a loopback-only trial configuration. Do not add a LAN
# address or firewall rule until the separate LAN admission review is approved.
# Keep Node/Vinext on 127.0.0.1:8787.

https://localhost:8443 {
	bind 127.0.0.1 [::1]
	tls internal
	reverse_proxy 127.0.0.1:8787
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}
