# Administrator/initial-pairing credential. Keep the real value in a protected
# Windows environment variable or credential store; paired devices use Ed25519
# request signatures for normal runtime traffic.
MURMUR_API_TOKEN=replace-with-a-long-random-token

# 4070 Windows self-host defaults. Claw may use http://127.0.0.1:8787 locally;
# Caddy should provide HTTPS for LAN clients. Bind hostname is passed to vinext start.
PORT=8787
MURMUR_ENFORCE_HTTPS=true
